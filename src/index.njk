---
layout: base.njk
---
<ul class="notes">
{% for post in collections.notes %}
  <li>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time>
    <div>
      <h2 class="note-title"><a href="{{ post.url }}">{{ post.data.title }}</a>{% if post.data.draft %}<span class="draft">draft</span>{% endif %}</h2>
      <p>{{ post.data.excerpt }}</p>
    </div>
  </li>
{% endfor %}
</ul>
